          "style": null,
          "blocks": [
            "cards-trust"
          ],
          "defaultContent": [
            "main.ftnt-main.trusted-section > div.container > div.row:nth-of-type(1)",
            "main.ftnt-main.trusted-section > div.container > div.cta-wrapper"
          ]
        },
        {
          "id": "rc13",
          "name": "Upcoming Events",
          "selector": "body > div.root.responsivegrid > div.aem-Grid.aem-Grid--12.aem-Grid--default--12 > div.C814-Event-News-Slider.aem-GridColumn.aem-GridColumn--default--12:nth-of-type(11)",
          "style": null,
          "blocks": [
            "cards-slider"
          ],
          "defaultContent": [
            "div.events-slider > div.row > div.col.section__head > h2.text-align--center"
          ]
        }
      ]
