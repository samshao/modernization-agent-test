          "style": "dark",
          "blocks": [
            "cards-stat"
          ],
          "defaultContent": [
            "div.global-scale > div.container > div.section__head",
            "div.global-scale > div.container > div.moreinfo"
          ]
        },
        {
          "id": "rc11",
          "name": "Customer Stories",
          "selector": "body > div.root.responsivegrid > div.aem-Grid.aem-Grid--12.aem-Grid--default--12 > div.C48-Form-HTML-Snippet.aem-GridColumn.aem-GridColumn--default--12:nth-of-type(9)",
          "style": null,
